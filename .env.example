# OpenAI-compatible chat and embedding API
OPENAI_API_KEY=
OPENAI_API_BASEURL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini

# Optional separate embedding credential; falls back to OPENAI_API_* when empty
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASEURL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-chatbot
PINECONE_NAMESPACE=training-gd4
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_CHUNK_STRATEGY=heading
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_SCORE_THRESHOLD=0.3
RAG_RETRIEVAL_DEDUP_ENABLED=true
RAG_RETRIEVAL_DEDUP_THRESHOLD=0.05
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=3
RAG_RETRIEVAL_HYBRID_ALPHA=0.5

# Visual extraction and captioning
RAG_VISUAL_PROVIDER=gemini
RAG_VISUAL_OUTPUT_DIR=output/rag_visuals
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Text-to-speech (edge-tts)
# CLI auto-speak after replies; Chat UI speaker icons always work on click.
TTS_ENABLED=false
TTS_AUTOPLAY=true
TTS_DEFAULT_LANGUAGE=vie
TTS_AUDIO_DIR=generated_audio
TTS_VOICE_POSITION_ENG=0
TTS_VOICE_POSITION_VIE=0

# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_MODEL=google/gemma-4-31b-it:free
